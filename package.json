{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "image-search",
  "title": "Image Web Search",
  "description": "Searches image using Google Image API",
  "icon": "assets/extension-icon.png",
  "author": "almatkai",
  "categories": ["Developer Tools"],
  "license": "MIT",
  "commands": [
    {
      "name": "search-images",
      "title": "Search Web Images",
      "description": "Searches Images on the web",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2",
    "file-type": "^21.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "preferences": [
    {
      "name": "apiKey",
      "type": "password",
      "required": true,
      "title": "API Key",
      "description": "API Key for Google Image Search (https://console.cloud.google.com/apis/credentials)"
    },
    {
      "name": "cxId",
      "type": "password",
      "required": true,
      "title": "CX ID",
      "description": "CX ID for Google Image Search (https://programmablesearchengine.google.com/controlpanel/all)"
    }
  ],
  "id": "com.tezbar.image-search",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/image-search",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/image-search",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
